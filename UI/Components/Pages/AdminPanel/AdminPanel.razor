              <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">Yeniden değerleme Oranı</span>
              </div>

              <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                      aria-describedby="inputGroup-sizing-sm" @bind="RevaluationRate">

            </div>

          </div>

          <!-- 5. Alan -->
          

          <!-- Buton -->
          <div class="row mt-1">
            <div class="col-3"></div>
            <div class="col-9 d-flex gap-2">
              <button class="btn AdminPanel_costom-btn" @onclick="() => EconomicIndicatorsAdd()">Kaydet</button>
              <button class="btn AdminPanel_costom-btn" @onclick="() => EconomicIndicatorsUpdate()">Güncelle</button>
              <button class="btn AdminPanel_costom-btn" @onclick="() => EconomicIndicatorsDelete()">Sil</button>

            </div>
          </div>

        </div>
      </div>

    </div>

    @if (!string.IsNullOrEmpty(EconomicIndicatorsMessage))
    {
        <div class="alert alert-warning mt-2" role="alert">
            @EconomicIndicatorsMessage
        </div>
    }

    <hr>
    <br>
    <br>

    <div class="container mt-4">

      <table class="table table-hover ">
        <thead>

          <tr class="table-light">
            <th scope="col">Yıl</th>
            <th scope="col">Asgari Ücret Artış Oranı</th>
            <th scope="col">Enflasyon Oranı</th>
            <th scope="col">Yeniden Değerleme Oranı</th>
            
          </tr>

        </thead>
        <tbody>
          
          @if (EconomicIndicatorsList.Count != 0)
          {
              @foreach (var item in EconomicIndicatorsList  )
            {
              <tr class="table-font">
                <td>@item.Year</td>
                <td>@item.MinimumWageIncreaseRate</td>
                <td>@item.InflationRate</td>
                <td>@item.RevaluationRate</td>
            </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" class="text-center">Ekonomik göstergeler tablosunda henüz kayıtlı veri yok.</td>
            </tr>
          }
           

        </tbody>
      </table>

    </div>

  }

  </main>
</div>



