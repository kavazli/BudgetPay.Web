@page "/adminPanel"
@rendermode InteractiveServer
@using Domain.TaxParameters
@using Domain.Enums


<div class="admin-shell">

  
  <aside class="admin-sidebar">
    <div class="container-fluid text-center">
      <div class="row" style="padding: 12px;">
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowMinimumWage" ? "active" : "")" @onclick='() => SetTab("ShowMinimumWage")'>Asgari Ücret</button>
        </div>
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowSSParams" ? "active" : "")" @onclick='() => SetTab("ShowSSParams")'>SGK Parametreleri</button>
        </div>
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowStampTax" ? "active" : "")" @onclick='() => SetTab("ShowStampTax")'>Damga Vergisi</button>
        </div>
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowIncomeTax" ? "active" : "")" @onclick='() => SetTab("ShowIncomeTax")'>Gelir Vergisi</button>
        </div>
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowDisabilityDegree" ? "active" : "")" @onclick='() => SetTab("ShowDisabilityDegree")'>Engelli İndirimi</button>
        </div>
        <div class="col">
          <button type="button" class="btn AdminPanel_costom-btn @(ActiveTab == "ShowEconomicIndicators" ? "active" : "")" @onclick='() => SetTab("ShowEconomicIndicators")'>Ekonomik Göstergeler</button>
        </div>
      </div>
    </div>
  </aside>

 <main class="admin-content">

@if (ActiveTab == "ShowMinimumWage")
{

  <div class="container mt-4">

    <div class="card shadow-sm">
      <div class="card-body">

        <!-- 1. Alan -->
        <div class="row mb-2">
    
          <div class="input-group input-group-sm mb-3">

            <div class="input-group-prepend">
              <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">Yıl</span>
            </div>

            <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                    aria-describedby="inputGroup-sizing-sm" @bind="minimum_wageYear">

          </div>

        </div>

        <!-- 2. Alan -->
        <div class="row mb-1">

          <div class="input-group input-group-sm mb-3">

            <div class="input-group-prepend">
              <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">Brüt Asgari Ücret</span>
            </div>

            <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                    aria-describedby="inputGroup-sizing-sm" @bind="grossSalary">

          </div>

        </div>

        <!-- 3. Alan -->
        <div class="row mb-1">

          <div class="input-group input-group-sm mb-3">

            <div class="input-group-prepend">
              <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">Net Asgari Ücret</span>
            </div>

            <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                    aria-describedby="inputGroup-sizing-sm" @bind="netSalary">

          </div>

        </div>

        <!-- 4. Alan -->
        <div class="row mb-1">

          <div class="input-group input-group-sm mb-3">

            <div class="input-group-prepend">
              <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">Emekli Net Asgari
                Ücret</span>
              </div>

              <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                      aria-describedby="inputGroup-sizing-sm" @bind="retiredNetSalary">

            </div>

          </div>

          <!-- 5. Alan -->
          <div class="row mb-1">

            <div class="input-group input-group-sm mb-3">

              <div class="input-group-prepend">
                <span class="input-group-text AdminPanel_label-width" id="inputGroup-sizing-sm">SGK Tavanı</span>
              </div>

              <input type="text" class="form-control AdminPanel_custom-input" aria-label="Small"
                      aria-describedby="inputGroup-sizing-sm" @bind="ceiling">

            </div>

          </div>

          <!-- Buton -->
          <div class="row mt-1">
            <div class="col-3"></div>
            <div class="col-9 d-flex gap-2">
              <button class="btn AdminPanel_costom-btn" @onclick="() => MinimumWageAdd()">Kaydet</button>
              <button class="btn AdminPanel_costom-btn" @onclick="() => MinimumWageUpdate()">Güncelle</button>
              <button class="btn AdminPanel_costom-btn" @onclick="() => MinimumWageDelete()">Sil</button>

            </div>
          </div>

        </div>
      </div>

    </div>

    @if (!string.IsNullOrEmpty(MinimumWageMessage))
    {
        <div class="alert alert-warning mt-2" role="alert">
            @MinimumWageMessage
        </div>
    }

    <hr>
    <br>
    <br>

    <div class="container mt-4">

      <table class="table table-hover ">
        <thead>

          <tr class="table-light">
            <th scope="col">Yıl</th>
            <th scope="col">Brüt</th>
            <th scope="col">Net</th>
            <th scope="col">Emekli Net</th>
            <th scope="col">SGK Tavanı</th>
          </tr>

        </thead>
        <tbody>
          
          @if (MinimumWages.Count != 0)
          {
              @foreach (var item in MinimumWages  )
            {
              <tr class="table-font">
                <td>@item.Year</td>
                <td>@item.GrossSalary.ToString("N2")</td>
                <td>@item.NetSalary.ToString("N2")</td>
                <td>@item.RetiredNetSalary.ToString("N2")</td>
                <td>@item.Ceiling.ToString("N2")</td>
            </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" class="text-center">Asgari ücret tablosunda henüz kayıtlı veri yok.</td>
            </tr>
          }
           

        </tbody>
      </table>

    </div>

  }


