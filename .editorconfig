root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.sln]
end_of_line = lf

[*.{cs,csproj,props,targets,razor,html,css,js,ts,json,xml,yml,yaml}]
end_of_line = lf

